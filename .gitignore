__pycache__/
*.py[cod]
*.pyo
.venv/
# `.env` alone matches only that exact name. A `.env.local`, a `.env.bak` or a
# `.env.prod` is the same file with the same secrets in it, and one of those
# reached a commit here via `git add -A` before this line existed.
.env
.env.*
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.pyright/
tokens.json

# Machine-specific compose additions — an extra read-only mount for a local
# document corpus, a different port, a bigger mem_limit. Docker Compose merges
# this automatically, so it belongs to the machine and not to the repo.
docker-compose.override.yml

# OAuth 2.0 bridge state (issued access/refresh tokens) — see oauth_bridge.py
oauth-state/

# The compose stack's default MCP_SHARED_DIR — everything the tools produce.
shared-files/

# Document fixtures are built by tests/fixtures/build.py, not committed: the
# 500-page budget fixture is large, and a real-world corpus must never be
# committed to a public repo. The builder is the artifact; its output is not.
tests/fixtures/corpus/

# Scratch output from local tool runs
out/
